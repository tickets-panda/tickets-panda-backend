NODE_ENV=development
PORT=5000
APP_NAME=TicketPanda
APP_URL=http://localhost:5000

# Database
# DB_DIALECT=mysql (production) or sqlite (zero-setup local dev)
DB_DIALECT=mysql
DB_STORAGE=./data/ticket-panda.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticket_panda
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_CUSTOMER_EXPIRY=30m

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ticketspanda.tech@gmail.com
SMTP_PASS=
EMAIL_FROM=ticketspanda.tech@gmail.com
EMAIL_FROM_NAME=Ticket Panda

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Frontend origins
CLIENT_URL=http://localhost:3000
TENANT_DASHBOARD_URL=http://localhost:3000
PLATFORM_ADMIN_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Seed credentials (used by npm run db:setup)
SEED_PLATFORM_OWNER_EMAIL=owner@ticketpanda.com
SEED_PLATFORM_OWNER_PASSWORD=Password123
SEED_DEMO_TENANT=true
